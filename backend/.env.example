# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_2=your-second-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_2=your-second-groq-api-key
GROQ_API_KEY_3=your-third-groq-api-key

# PostgreSQL Direct Connection String (Required for table DDL operations)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# GitHub Personal Access Token (Required for querying Actions run history)
# Create at: https://github.com/settings/tokens/new
# Required scopes: repo (or actions:read + metadata:read)
GH_TOKEN=ghp_your_personal_access_token_here

# Twilio Configuration (Required for phone verification)
# Create account at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Demo Allowlist (Comma-separated list of demo account emails)
# These accounts bypass plan and quota enforcement for demo purposes
# Example: demo@trendrop.app,test@example.com
DEMO_ALLOWLIST=

# Heartbeat Monitoring
# Webhook URL for cron heartbeat alerts (Slack, Discord, etc.)
CRON_HEARTBEAT_WEBHOOK_URL=
# Email address for heartbeat alert fallback (requires RESEND_API_KEY)
CRON_HEARTBEAT_ALERT_EMAIL=

# WhatsApp Alerts (Optional - for real WhatsApp delivery via Meta Cloud API)
# Currently defaults to mock mode (WHATSAPP_MOCK_MODE=true)
# For real delivery, configure these and set WHATSAPP_MOCK_MODE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MOCK_MODE=true
