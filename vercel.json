{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.py" }],
  "crons": [
    {
      "path": "/api/cron/trigger",
      "schedule": "0 */3 * * *"
    }
  ]
}
