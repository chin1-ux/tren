{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build && cp -r .vercel/output ../.vercel/output",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://trendrop-backend-production.up.railway.app/api/$1"
    },
    {
      "source": "/outputs/(.*)",
      "destination": "https://trendrop-backend-production.up.railway.app/outputs/$1"
    }
  ]
}
