{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm run build && cd .. && python inject_routes.py",
  "installCommand": "pip install --break-system-packages -r requirements-serverless.txt && cd frontend && npm install",
  "framework": null,
  "functions": {
    "api/[...path].py": {
      "excludeFiles": "{evidence/**,scripts/**,backend/migrations/**,backend/tests/**,backend/test_*/**,backend/outputs/**,backend/scratch/**,backend/venv*/**,backend/venv_shazam/**,_uv/**,clickthrough_output/**,artifacts/**,scratch/**,backend/*.md,*.log,**/*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/[...path]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 0 * * *"
    }
  ]
}
